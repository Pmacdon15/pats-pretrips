DATABASE_URL=

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
REVERSE_GEOCODING_API_KEY=

# AI connector (optional; see docs/mcp-ai-guide.md)
# The issuer AI apps sign in with. Defaults to the Clerk Frontend API from the publishable key.
MCP_OAUTH_ISSUER=
# Only accept OAuth access tokens whose `aud` claim names one of these (comma separated).
# Set it to the MCP URL, e.g. https://patspretrips.ca/api/mcp, but only after adding that
# URL in the Clerk dashboard under Agents -> MCP servers (which turns on audience claims)
# and seeing it in the "this token's aud" log line. Unset: the audience is NOT checked, so
# a token Clerk issued to any app is accepted, and production logs a warning once per instance.
MCP_TOKEN_AUDIENCE=

LIMIT_FOR_PAG=4