{
	"name": "pats-pretrips",
	"version": "2.7.1",
	"private": true,
	"scripts": {
		"dev": "bun --bun next dev --turbopack",
		"build": "bun --bun next build --turbopack",
		"start": "bun --bun next start",
		"lint": "biome check --write --unsafe",
		"format": "biome format --write",
		"postbuild": "next-sitemap --config next-sitemap.config.cjs",
		"typecheck": "next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:unit": "vitest run --project unit",
		"test:components": "vitest run --project components",
		"test:app": "vitest run --project app",
		"test:build": "next build && vitest run --project build",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"dependencies": {
		"@aws-sdk/client-sesv2": "^3.1168.0",
		"@biomejs/biome": "^2.4.16",
		"@clerk/nextjs": "^7.9.25",
		"@fortawesome/fontawesome-svg-core": "^7.2.0",
		"@fortawesome/free-brands-svg-icons": "^7.2.0",
		"@fortawesome/react-fontawesome": "^3.3.1",
		"@hookform/resolvers": "^5.4.0",
		"@modelcontextprotocol/server": "^2.4.0",
		"@neondatabase/serverless": "^1.1.0",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-form": "^1.33.0",
		"@tanstack/react-query": "^5.100.14",
		"@vercel/analytics": "^2.0.1",
		"babel-plugin-react-compiler": "^1.0.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"jose": "^6.2.17",
		"lucide-react": "^1.17.0",
		"mcp-handler": "^2.3.0",
		"neverthrow": "^8.2.0",
		"next": "^16.2.6",
		"next-sitemap": "^4.2.3",
		"next-themes": "^0.4.6",
		"pdf-lib": "^1.17.1",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.0",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitest/coverage-v8": "^5.0.3",
		"jsdom": "^31.0.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vitest": "^5.0.3"
	},
	"packageManager": "bun@1.4.4"
}
